# Server
PORT=8000
NODE_ENV=production
CORS_ORIGIN=https://agrik.co,https://www.agrik.co

# Database
DATABASE_URL=postgresql://agrik:CHANGE_ME@localhost:5432/agrik_db

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_STRING
ADMIN_JWT_EXPIRES_IN=12h

# Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alerts@agrik.co
SMTP_PASS=CHANGE_ME
MAIL_FROM="AGRIK <alerts@agrik.co>"

# AI — DeepSeek (chat + vision)
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-pro
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# AI — OpenAI (audio transcription + text-to-speech)
OPENAI_API_KEY=CHANGE_ME
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Uploaded media
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=https://api.agrik.co/uploads
